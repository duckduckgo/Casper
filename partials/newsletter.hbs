<form class="newsletter js-newsletter" action="https://duckduckgo.com/newsletter/subscription/subscribe" method="post" name="y">
  <input type="hidden" name="page" value="1">
  <input type="hidden" name="flow" value="blog">
  <input type="hidden" name="news" value="on">
  <img class="newsletter__icon" src="{{asset 'newsletter-email.svg'}}" alt="" width="144" height="144" />
  <h2 class="newsletter__title">Privacy tips and news, straight to your inbox.</h2>
  <p class="newsletter__tagline">Stay protected and informed with our privacy newsletter. <a href="https://duckduckgo.com/newsletter" target="_blank" rel="noopener">Learn more.</a></p>
  <div class="newsletter__fields">
    <input class="newsletter__email" type="email" name="email" placeholder="Enter your email address" aria-label="Email address" required>
    <input class="newsletter__submit" type="submit" value="Subscribe">
  </div>
  <p class="newsletter__privacy">Your email address won't be shared and you can unsubscribe at any time.</p>
</form>
