<article class="post-card {{post_class}}{{#unless feature_image}} no-image{{/unless}}">
    {{#if feature_image}}
        <a class="post-card-image-link" href="{{url}}">
            {{!-- `wide` marks the cards screen.css lays out in the full-width
                  6n+1 slot; only index.hbs sets it. `eager` is the first card of
                  any feed, which is the LCP element. --}}
            {{#if wide}}
                {{> "responsive-image" image=feature_image alt=title class="post-card-image" imgsize="l" eager=@first
                    sizes="(min-width: 795px) 683px, (min-width: 650px) 45vw, 92vw"}}
            {{else}}
                {{> "responsive-image" image=feature_image alt=title class="post-card-image" imgsize="m" eager=@first
                    sizes="(min-width: 795px) 320px, (min-width: 650px) 45vw, 92vw"}}
            {{/if}}
        </a>
    {{/if}}
    <div class="post-card-content">
        <a class="post-card-content-link" href="{{url}}">
            <header class="post-card-header">
                {{#if primary_tag}}
                    <span class="post-card-tags">{{primary_tag.name}}</span>
                {{/if}}
                <h2 class="post-card-title">{{title}}</h2>
            </header>
            <section class="post-card-excerpt">
                <p>{{excerpt words="33"}}</p>
            </section>
        </a>
        <footer class="post-card-meta">

            {{#primary_author}}
                <div class="post-card-author">
                    {{#if profile_image}}
                        <a href="{{url}}" class="static-avatar">{{> "responsive-image" image=profile_image alt=name class="author-profile-image" imgsize="xs" px="34"}}</a>
                    {{else}}
                        <a href="{{url}}" class="static-avatar author-profile-image" aria-label="{{name}}">{{> "icons/avatar"}}</a>
                    {{/if}}
                </div>
            {{/primary_author}}

            <div class="post-card-byline-date">
                <time class="post-card-meta-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
                {{#if reading_time}}
                    <span class="post-card-meta-separator">&middot;</span>
                    <span class="reading-time">{{reading_time}}</span>
                {{/if}}
            </div>

        </footer>
    </div>
</article>
