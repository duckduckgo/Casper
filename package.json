{
  "name": "casper",
  "description": "The default personal blogging theme for Ghost. Beautiful, minimal and responsive.",
  "demo": "https://demo.ghost.io",
  "version": "5.11.1",
  "engines": {
    "ghost": ">=5.0.0",
    "node": ">=22.13.1"
  },
  "license": "MIT",
  "screenshots": {
    "desktop": "assets/screenshot-desktop.jpg",
    "mobile": "assets/screenshot-mobile.jpg"
  },
  "scripts": {
    "dev": "gulp",
    "build": "gulp build",
    "zip": "gulp zip",
    "test": "yarn build && yarn test:gscan",
    "test:gscan": "gscan . --verbose",
    "test:gscan:fatal": "gscan . --fatal --verbose",
    "test:smoke": "playwright test tests/theme-smoke.spec.js",
    "test:vrt": "playwright test tests/theme-vrt.spec.js"
  },
  "author": {
    "name": "Ghost Foundation",
    "email": "hello@ghost.org",
    "url": "https://ghost.org"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Magazine"
    ]
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TryGhost/Casper.git"
  },
  "bugs": "https://github.com/TryGhost/Casper/issues",
  "contributors": "https://github.com/TryGhost/Casper/graphs/contributors",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "autoprefixer": "^10.4.24",
    "beeper": "^2.1.0",
    "cssnano": "^7.1.2",
    "gscan": "5.2.4",
    "gulp": "5.0.1",
    "gulp-livereload": "^4.0.2",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "gulp-zip": "^6.1.0",
    "postcss": "^8.5.6",
    "postcss-color-function": "^4.1.0",
    "postcss-custom-properties": "^15.0.1",
    "postcss-easy-import": "^4.0.0",
    "pump": "^3.0.3"
  },
  "browserslist": [
    "defaults"
  ],
  "config": {
    "posts_per_page": 25,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "card_assets": true
  }
}
